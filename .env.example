# Supabase (browser). Leave blank to run in guest-only mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AdMob. Live units are used only when BOTH are set for a production build:
#   VITE_ADMOB_USE_LIVE=true
#   and the three unit ids below.
# Development and any build without that flag uses Google's official test ids.
# VITE_ADMOB_USE_LIVE=true
# VITE_ADMOB_BANNER_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
# VITE_ADMOB_REWARDED_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# Native AdMob app id, read by capacitor.config.ts at `cap sync` time (not the Vite bundle).
# Leave unset to embed Google's Android test app id.
# ADMOB_USE_LIVE=true
# ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx

# Edge Function secrets (set with `supabase secrets set`, never in the client):
# SUPABASE_SERVICE_ROLE_KEY          injected by Supabase
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON   Play Console service account JSON, one line
# ANDROID_PACKAGE_NAME               defaults to com.tetrix.game
# ALLOW_DEV_PURCHASES                "true" only on a local/dev project, never production
